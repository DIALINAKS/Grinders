{
  "expo": {
    "name": "Dial In",
    "slug": "grind-dial-in",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#202033",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#202033"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baristalife.grinddialin"
    },
    "android": {
      "package": "com.baristalife.grinddialin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#202033"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
